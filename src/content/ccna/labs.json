            "kind": "switch",
            "label": "SW2",
            "x": 4,
            "y": 1,
            "note": "2960-24TT"
          },
          {
            "id": "pc1",
            "kind": "pc",
            "label": "PC1",
            "x": 0,
            "y": 2
          },
          {
            "id": "pc2",
            "kind": "pc",
            "label": "PC2",
            "x": 4,
            "y": 2
          }
        ],
        "links": [
          {
            "from": "r1",
            "to": "sw1",
            "fromPort": "G0/0/0",
            "toPort": "G0/1"
          },
